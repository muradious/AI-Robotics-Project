/*
 * esp32_rover.ino -- a real robot that follows the policy learned in simulation
 * ==============================================================================
 * !! NOT YET TESTED ON REAL HARDWARE !!  The planner (planner.h) is verified on a PC against the
 * Python code, but the motor / sensor timing constants below MUST be calibrated on your robot.
 * Follow hardware/HARDWARE.md step by step.  Needs "esp32 by Espressif" board package 3.x
 * (analogWrite() on ESP32 was added in 3.0).
 *
 * THE BIG PICTURE
 *   The floor has an 8x8 grid of black tape lines.  Each tape CROSSING is one grid cell/"state"
 *   of the MDP.  Between crossings the robot FOLLOWS THE LINE.  At each crossing it
 *      1. reads the action from its policy      (UP / RIGHT / DOWN / LEFT)
 *      2. turns to face that direction          (rotate until the line sensor finds the next tape line)
 *      3. looks ahead with the ultrasonic sensor
 *            - clear      -> drive to the next crossing
 *            - obstacle   -> mark that cell as blocked, RE-PLAN with Value Iteration, try again
 *   until it reaches the goal crossing.
 *
 * CODE MAP (read top to bottom)
 *   1. Pins & tuning constants      <- the numbers you calibrate
 *   2. Low-level helpers            motors, line sensors, distance sensor
 *   3. Motion primitives            rotate(), driveToNextNode()
 *   4. setup() / loop()             the control flow described above
 */

#include <Arduino.h>
#include "map.h"        // generated by hardware/export_policy.py: maze + policy learned in simulation
#include "planner.h"    // Value Iteration on the robot (same maths as dp.py)

// ============================================================================
// 1. PINS & TUNING CONSTANTS
// ============================================================================
// ---- Motor driver HG7881 (2 channels; per channel: one pin = forward PWM, other = reverse PWM)
const int PIN_L_FWD = 25, PIN_L_REV = 26;      // left motor   (HG7881 A-IA, A-IB)
const int PIN_R_FWD = 27, PIN_R_REV = 33;      // right motor  (HG7881 B-IA, B-IB)
const int LEFT_SIGN = +1, RIGHT_SIGN = +1;     // set to -1 if a wheel spins the wrong way

// ---- Line sensors (3x TCRT5000 modules, digital output). GPIO34/35 are input-only pins: fine.
const int PIN_LINE_L = 34, PIN_LINE_M = 35, PIN_LINE_R = 32;
const bool LINE_IS_HIGH = true;                // true if the module outputs HIGH over black tape

// ---- Ultrasonic HC-SR04.  !! ECHO outputs 5 V: use a 1k + 2k voltage divider into the ESP32 !!
const int PIN_TRIG = 23, PIN_ECHO = 19;
const int OBSTACLE_CM = 16;                    // closer than this = something is on the next crossing

// ---- Misc
const int PIN_BUTTON = 0;                      // the BOOT button on the dev board
const int PIN_LED = 2;                         // on-board LED

// ---- Speeds (0..255).  Motors are 3-6 V; if you power from 2x18650 (7.4 V) keep MAX_PWM <= ~200.
const int MAX_PWM = 200;
const int BASE_PWM = 140;                      // cruising speed while line following
const int TURN_PWM = 130;                      // speed while spinning on the spot
const int STEER_GAIN = 45;                     // how hard to correct when drifting off the line

// ---- Calibration (milliseconds) -- THESE DEPEND ON YOUR ROBOT, see HARDWARE.md
const int NUDGE_MS = 350;                      // after detecting a crossing: roll forward so the WHEEL AXLE is over it
const int TURN_OVERSHOOT_MS = 25;              // extra spin after the sensor finds the new line (centres it)
const int TURN_TIMEOUT_MS = 3500;              // give up if a quarter turn takes longer than this
const int SEGMENT_TIMEOUT_MS = 8000;           // give up if the next crossing does not appear
const int MIN_SEGMENT_MS = 250;                // ignore the crossing detector right after starting

// Set to 1 to run a hardware self-test (prints sensors, spins motors) instead of the mission.
#define TEST_MODE 0

// ============================================================================
// 2. LOW-LEVEL HELPERS
// ============================================================================
// ---- State of the robot (the MDP state = row/col; heading is extra bookkeeping the simulator did not need)
int curR = START_R, curC = START_C;
int heading = 2;                               // 0=N(UP) 1=E 2=S(DOWN) 3=W.  Robot must start FACING this way.
planner::Grid grid;                            // the robot's current map + value function + policy
bool useLearnedPolicy = true;                  // true until the first re-plan; then the on-board policy is used

// Drive one motor with a signed speed (-255..255); positive = forward.
void setMotor(int fwdPin, int revPin, int speed) {
  speed = constrain(speed, -MAX_PWM, MAX_PWM);
  if (speed >= 0) { analogWrite(fwdPin, speed); analogWrite(revPin, 0); }
  else            { analogWrite(fwdPin, 0);     analogWrite(revPin, -speed); }
}
void drive(int left, int right) {
  setMotor(PIN_L_FWD, PIN_L_REV, LEFT_SIGN * left);
  setMotor(PIN_R_FWD, PIN_R_REV, RIGHT_SIGN * right);
}
void stopMotors() { drive(0, 0); }

// True if that sensor currently sees the black tape.
bool onLine(int pin) { return digitalRead(pin) == (LINE_IS_HIGH ? HIGH : LOW); }

// Distance ahead in cm (median of 3 pings; 999 = nothing in range).
long readCm() {
  long d[3];
  for (int i = 0; i < 3; i++) {
    digitalWrite(PIN_TRIG, LOW);  delayMicroseconds(2);
    digitalWrite(PIN_TRIG, HIGH); delayMicroseconds(10);
    digitalWrite(PIN_TRIG, LOW);
    long us = pulseIn(PIN_ECHO, HIGH, 25000);    // 25 ms timeout ~ 4 m
    d[i] = (us == 0) ? 999 : us / 58;
    delay(15);
  }
  if (d[0] > d[1]) { long t = d[0]; d[0] = d[1]; d[1] = t; }
  if (d[1] > d[2]) { long t = d[1]; d[1] = d[2]; d[2] = t; }
  if (d[0] > d[1]) { long t = d[0]; d[0] = d[1]; d[1] = t; }
  return d[1];
}

// Something went wrong (timeout / unreachable goal): stop and blink forever.
void fail(const char *why) {
  stopMotors();
  Serial.printf("STOPPED: %s\n", why);
  while (true) { digitalWrite(PIN_LED, !digitalRead(PIN_LED)); delay(120); }
}

// ============================================================================
// 3. MOTION PRIMITIVES
// ============================================================================
// Wait until the CENTRE sensor reaches `state` (true = on tape). False on timeout.
bool waitCentre(bool state, int timeoutMs) {
  unsigned long t0 = millis();
  while (onLine(PIN_LINE_M) != state) {
    if (millis() - t0 > timeoutMs) return false;
  }
  return true;
}

// Rotate on the spot by `quarters` x 90 degrees (+1 = right/clockwise, -1 = left, 2 = half turn).
// How it works: the robot sits on a crossing with its wheel axle over the middle. Spinning, the
// centre sensor swings off the current line and then crosses the PERPENDICULAR tape line exactly
// 90 degrees later; each such crossing = one quarter turn.
void rotate(int quarters) {
  if (quarters == 0) return;
  int dir = (quarters > 0) ? 1 : -1;
  drive(dir * TURN_PWM, -dir * TURN_PWM);
  for (int i = 0; i < abs(quarters); i++) {
    if (!waitCentre(false, TURN_TIMEOUT_MS)) fail("turn: never left the line");
    if (!waitCentre(true, TURN_TIMEOUT_MS)) fail("turn: never found the next line");
  }
  delay(TURN_OVERSHOOT_MS);
  stopMotors();
  delay(150);
  heading = (heading + quarters + 8) % 4;
}

// Follow the tape until BOTH outer sensors see tape at once = the next crossing.
// Steering: a simple proportional rule -- if the left sensor sees tape we drifted right, so steer left.
void driveToNextNode() {
  unsigned long t0 = millis();
  int lastSteer = 0;
  while (true) {
    bool l = onLine(PIN_LINE_L), m = onLine(PIN_LINE_M), r = onLine(PIN_LINE_R);
    if (l && r && millis() - t0 > MIN_SEGMENT_MS) break;       // crossing found
    int steer;
    if (l && !r)      steer = -STEER_GAIN;                      // line is to the left  -> turn left
    else if (r && !l) steer = +STEER_GAIN;                      // line is to the right -> turn right
    else if (m)       steer = 0;                                // on the line: go straight
    else              steer = lastSteer;                        // lost it: keep the last correction
    lastSteer = steer;
    drive(BASE_PWM + steer, BASE_PWM - steer);
    if (millis() - t0 > SEGMENT_TIMEOUT_MS) fail("lost the line / no crossing");
  }
  // Roll forward a little so the wheel axle (= centre of rotation) is exactly over the crossing.
  drive(BASE_PWM, BASE_PWM);
  delay(NUDGE_MS);
  stopMotors();
  delay(150);
}

// ============================================================================
// 4. SETUP & MAIN LOOP
// ============================================================================
void loadMap() {
  for (int r = 0; r < GRID_N; r++)
    for (int c = 0; c < GRID_N; c++)
      grid.blocked[r][c] = (MAP_ROWS[r][c] == '#');
  grid.goalR = GOAL_R_CELL;
  grid.goalC = GOAL_C_CELL;
  planner::valueIteration(grid);                   // also gives us the on-board policy for later
}

void hardwareSelfTest() {
  Serial.println("TEST MODE: move the robot over tape; watch L M R and distance. Motors run 1 s each.");
  while (true) {
    Serial.printf("L=%d M=%d R=%d  dist=%ldcm\n", onLine(PIN_LINE_L), onLine(PIN_LINE_M), onLine(PIN_LINE_R), readCm());
    if (digitalRead(PIN_BUTTON) == LOW) {          // press BOOT to run the motor test
      Serial.println("left fwd");   drive(BASE_PWM, 0);  delay(1000); stopMotors(); delay(500);
      Serial.println("right fwd");  drive(0, BASE_PWM);  delay(1000); stopMotors(); delay(500);
      Serial.println("both fwd");   drive(BASE_PWM, BASE_PWM); delay(1000); stopMotors(); delay(500);
      Serial.println("spin right"); drive(TURN_PWM, -TURN_PWM); delay(1000); stopMotors(); delay(500);
    }
    delay(200);
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_LINE_L, INPUT); pinMode(PIN_LINE_M, INPUT); pinMode(PIN_LINE_R, INPUT);
  pinMode(PIN_TRIG, OUTPUT);  pinMode(PIN_ECHO, INPUT);
  pinMode(PIN_BUTTON, INPUT_PULLUP);
  pinMode(PIN_LED, OUTPUT);
  stopMotors();

#if TEST_MODE
  hardwareSelfTest();
#endif

  loadMap();
  Serial.printf("Ready. Start (%d,%d) -> goal (%d,%d). Put the robot's wheel axle on the start crossing,\n"
                "facing heading %d (0=N 1=E 2=S 3=W), then press BOOT.\n",
                START_R, START_C, GOAL_R_CELL, GOAL_C_CELL, heading);
  while (digitalRead(PIN_BUTTON) == HIGH) delay(20);
  delay(500);
}

void loop() {
  // ---- reached the goal? ----------------------------------------------------
  if (curR == GOAL_R_CELL && curC == GOAL_C_CELL) {
    stopMotors();
    Serial.println("GOAL REACHED!");
    while (true) { digitalWrite(PIN_LED, !digitalRead(PIN_LED)); delay(300); }
  }

  // ---- 1. choose an action from the policy -------------------------------
  uint8_t a = useLearnedPolicy ? PLANNED_POLICY[curR][curC] : grid.policy[curR][curC];
  int nr = curR + planner::DR[a], nc = curC + planner::DC[a];
  Serial.printf("at (%d,%d) heading %d -> action %d (target %d,%d)\n", curR, curC, heading, a, nr, nc);

  // Safety: if the policy points outside the map or into a known obstacle, re-plan instead of crashing.
  if (!planner::inside(nr, nc) || grid.blocked[nr][nc]) {
    useLearnedPolicy = false;
    if (!planner::replan(grid, curR, curC)) fail("goal unreachable");
    return;
  }

  // ---- 2. turn to face that direction ---------------------------------------
  int diff = (a - heading + 4) % 4;                // 0 = already facing, 1 = right, 2 = back, 3 = left
  rotate(diff == 3 ? -1 : diff);

  // ---- 3. look before leaping: is the next crossing really free? ----------
  long cm = readCm();
  if (cm < OBSTACLE_CM) {
    Serial.printf("obstacle %ld cm ahead -> mark (%d,%d) blocked and re-plan\n", cm, nr, nc);
    grid.blocked[nr][nc] = true;
    useLearnedPolicy = false;
    if (!planner::replan(grid, curR, curC)) fail("goal unreachable");
    return;                                         // loop() runs again with the new policy
  }

  // ---- 4. drive to the next crossing and update our position -------------
  driveToNextNode();
  curR = nr; curC = nc;
}
